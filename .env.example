# ====================================================================
# AERO EDGE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Hướng dẫn: Tạo bản sao file này thành .env và điền thông tin mạng của bạn
# ====================================================================

# ESP32 WiFi settings; host capture uses the OS's existing network connection.
WIFI_SSID="YOUR_SURVEY_SSID"
WIFI_PASSWORD=""

# MQTT Broker Settings
MQTT_BROKER_HOST="192.168.1.100"
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID="ESP32-EdgeProbe-01"

# Web Dashboard & Backend Settings
PORT=8000
ANOMALY_THRESHOLD=0.55

# Manual values take priority; credential discovery is opt-in.
AUTO_DETECT_WIFI=false
MQTT_AUTO_DISCOVERY=false
# Host uses an already connected OS interface (tshark -D).
# run_system.py refreshes this key automatically with active physical device IDs
# at each ordinary live host startup, overriding stale choices after moving networks.
# Lab modes select loopback in memory and do not persist it over this setting.
HOST_CAPTURE_INTERFACES="auto"
# Optional: replay a PCAP/PCAPNG with two-pass dissection instead of live capture.
# Clear this value to capture the configured interface.
HOST_PCAP_FILE=""
HOST_PROBE_ID="Host-PC-Live-Probe"

# Attack experiments use an explicit local lab, never auto-selected gateways.
LAB_TARGET_IP="127.0.0.1"
# Twin automatically adds only 127.0.0.1/32 to the allowlist at startup.
# Native lab owns LAB_HTTP_PORT..LAB_HTTP_PORT+11 (two open TCP, ten closed).
TWIN_SCAN_PORT_COUNT=12
LAB_ALLOWED_TARGETS="127.0.0.1/32"
LAB_HTTP_PORT=8088
LAB_CAPTURE_INTERFACES="auto-loopback"
# Twin experiments own capture/import and start only from UI. Native owns its
# HTTP endpoint; docker requires digital_twin/lab/compose.yaml already running.
TWIN_LAB_BACKEND="native"
TWIN_CAPTURE_INTERFACE="auto-loopback"
# Base seed mixed with experiment ID; manifest stores the actual replay seed.
TWIN_VARIATION_SEED=42
# Normal host capture uses HOST_CAPTURE_INTERFACES; the lab flags override it
# for that process only. auto-loopback avoids changing numeric NIC indices.
# Native Twin starts its own HTTP target. --lab-capture alone starts no workload.
# Wi-Fi traffic to the Internet is not captured on loopback. See README.md.
